  "tips": {
    "pollen": [
      "Lüften: in der Stadt früh morgens (ca. 6–8 Uhr), auf dem Land abends (ca. 19–24 Uhr).",
      "Haare abends waschen, Straßenkleidung nicht im Schlafzimmer ablegen.",
      "Nach einem kräftigen Regenschauer ist die Luft vorübergehend pollenarm.",
      "Pollenschutzgitter am Fenster und Pollenfilter im Auto verwenden.",
      "Sonnenbrille schützt die Augen vor Pollen."
    ],
    "milben": [
      "Milbendichte Matratzenbezüge (Encasings) verwenden.",
      "Bettwäsche bei mindestens 60 °C waschen.",
      "Luftfeuchtigkeit unter 50 % halten, Schlafzimmer kühl."
    ],
    "schimmel": [
      "Laub, Kompost und Biotonne meiden.",
      "Regelmäßig stoßlüften, Luftfeuchtigkeit kontrollieren."
    ],
    "tierhaare": [
      "Tiere nicht ins Schlafzimmer lassen.",
      "HEPA-Luftreiniger kann die Belastung senken."
    ],
    "insekten": [
      "Notfallset immer dabei haben und Anwendung üben.",
      "Im Freien nicht barfuß laufen, süße Getränke abdecken."
    ]
  },
